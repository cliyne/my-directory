---
const { title, description } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
      :root {
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --bg: #f8fafc;
        --card-bg: #ffffff;
        --text: #0f172a;
        --text-muted: #64748b;
        --border: #e2e8f0;
      }
      * { box-sizing: border-box; }
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background-color: var(--bg);
        color: var(--text);
        margin: 0;
        padding: 0;
        line-height: 1.6;
      }
      header {
        background: #ffffff;
        border-bottom: 1px solid var(--border);
        padding: 1rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      header a {
        text-decoration: none;
        color: var(--text);
        font-weight: 700;
        font-size: 1.25rem;
      }
      header nav a {
        font-weight: 500;
        font-size: 0.95rem;
        color: var(--text-muted);
      }
      header nav a:hover {
        color: var(--primary);
      }
      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
      }
      footer {
        text-align: center;
        font-size: 0.85rem;
        color: var(--text-muted);
        padding: 3rem 0;
        border-top: 1px solid var(--border);
        margin-top: 4rem;
        background: #ffffff;
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/">DirectoryHub</a>
      <nav>
        <a href="/">Browse All</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; 2026 DirectoryHub. Built with Astro & Cloudflare Pages.</p>
    </footer>
  </body>
</html>
