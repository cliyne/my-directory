---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntries, type Entry } from '../lib/data';

export function getStaticPaths() {
  const entries = getEntries();
  return entries.map((entry) => {
    const picked = entry.alternatives
      .map((s) => entries.find((e) => e.slug === s))
      .filter((e): e is Entry => Boolean(e));
    const filler = entries
      .filter((e) => e.category === entry.category && e.slug !== entry.slug && !entry.alternatives.includes(e.slug))
      .slice(0, Math.max(0, 3 - picked.length));
    return { params: { slug: entry.slug }, props: { entry, alternatives: [...picked, ...filler] } };
  });
}

const { entry, alternatives } = Astro.props;
const outbound = entry.affiliateUrl || entry.url;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: entry.name,
  applicationCategory: entry.category,
  description: entry.tagline,
  url: entry.url,
};
---
<BaseLayout title={`${entry.name}: Features, Pricing & Alternatives`} description={entry.tagline}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <article class="detail">
    <nav class="crumbs"><a href="/">Home</a> / {entry.category} / {entry.name}</nav>
    <div class="badges">
      <span class="badge">{entry.category}</span>
      {entry.pricing && <span class="badge price">{entry.pricing}</span>}
    </div>
    <h1>{entry.name}</h1>
    <p class="lead">{entry.tagline}</p>
    {entry.updated && <p class="meta">Last updated {entry.updated}</p>}

    <div class="panel">
      <h2>What is {entry.name}?</h2>
      <p>{entry.description}</p>
      {entry.bestFor && <p style="margin-top:12px"><strong>Best for:</strong> {entry.bestFor}</p>}
      {outbound && <a class="btn" href={outbound} target="_blank" rel="noopener sponsored nofollow">Visit {entry.name} →</a>}
    </div>

    {entry.features.length > 0 && (
      <div class="panel">
        <h2>Key features</h2>
        <ul class="list">{entry.features.map((f) => <li>{f}</li>)}</ul>
      </div>
    )}

    {(entry.pros.length > 0 || entry.cons.length > 0) && (
      <div class="cols">
        <div class="panel">
          <h2>Pros</h2>
          <ul class="list pros">{entry.pros.map((p) => <li>{p}</li>)}</ul>
        </div>
        <div class="panel">
          <h2>Cons</h2>
          <ul class="list cons">{entry.cons.map((c) => <li>{c}</li>)}</ul>
        </div>
      </div>
    )}

    <div class="ad-slot"></div>

    {alternatives.length > 0 && (
      <>
        <h2 class="section">Alternatives to {entry.name}</h2>
        <div class="grid">
          {alternatives.map((r) => (
            <a class="card" href={`/${r.slug}/`}>
              <div class="avatar">{r.name.charAt(0).toUpperCase()}</div>
              <h3>{r.name}</h3>
              <p class="tagline">{r.tagline}</p>
            </a>
          ))}
        </div>
      </>
    )}
  </article>
</BaseLayout>
