---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntries } from '../lib/data';

export function getStaticPaths() {
  const entries = getEntries();
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      related: entries.filter((e) => e.category === entry.category && e.slug !== entry.slug).slice(0, 3),
    },
  }));
}
const { entry, related } = Astro.props;
---
<BaseLayout title={`${entry.name} – Pricing, Features & Alternatives`} description={entry.tagline}>
  <article class="detail">
    <nav class="crumbs"><a href="/">Home</a> / {entry.category} / {entry.name}</nav>
    <div class="badges">
      <span class="badge">{entry.category}</span>
      {entry.pricing && <span class="badge price">{entry.pricing}</span>}
    </div>
    <h1>{entry.name}</h1>
    <p class="lead">{entry.tagline}</p>

    <div class="panel">
      <p>{entry.description}</p>
      <div class="badges" style="margin-top:16px">
        {entry.tags.map((t) => <span class="badge tag">{t}</span>)}
      </div>
      {entry.url && <a class="btn" href={entry.url} target="_blank" rel="noopener sponsored nofollow">Visit {entry.name} →</a>}
    </div>

    <div class="ad-slot"></div>

    {related.length > 0 && (
      <>
        <h2 class="section">More in {entry.category}</h2>
        <div class="grid">
          {related.map((r) => (
            <a class="card" href={`/${r.slug}/`}>
              <div class="avatar">{r.name.charAt(0).toUpperCase()}</div>
              <h3>{r.name}</h3>
              <p class="tagline">{r.tagline}</p>
            </a>
          ))}
        </div>
      </>
    )}
  </article>
</BaseLayout>
